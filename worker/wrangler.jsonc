{
  // Cloudflare Worker der serverer feedet til telefonerne.
  // Se worker/README.md for opsaetning.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unikum-feed",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Lageret hedder "unikum-feed-kv". ID'et er ikke en hemmelighed -
  // det er ubrugeligt uden kontoens legitimationsoplysninger.
  "kv_namespaces": [
    {
      "binding": "FEED",
      "id": "dc87308474634514a71240083da30d03"
    }
  ]

  // FEED_TOKEN og PUSH_TOKEN saettes som secrets, ikke her:
  //   wrangler secret put FEED_TOKEN
  //   wrangler secret put PUSH_TOKEN
}
