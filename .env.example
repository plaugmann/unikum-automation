# ---------------------------------------------------------------
# Kopier denne fil til .env og udfyld vaerdierne. .env er gitignored.
# ---------------------------------------------------------------

# OpenAI - bruges til at opsummere og kategorisere beskeder
OPENAI_API_KEY=
# Valgfrit: laases fast naar vi har bekraeftet hvilken model kontoen har adgang til
OPENAI_MODEL=gpt-5.4

# Unikum
UNIKUM_PID=11373201365
# Hent kun materiale fra og med denne dato (skolestart)
UNIKUM_SINCE=2026-08-01

# Hemmelig token der skal med som ?token=... paa /feed.xml og /display.json
FEED_TOKEN=

# Lokal webserver
HOST=0.0.0.0
PORT=8080
# Base-URL der bruges i RSS-links (saet til maskinens LAN-IP naar ESP32 skal hente)
PUBLIC_BASE_URL=http://localhost:8080

# Publicering til Cloudflare-workeren. Lad dem staa tomme for ren lokal drift.
# Se worker/README.md for opsaetning.
CLOUD_URL=
CLOUD_PUSH_TOKEN=

# Kun til udrulning af workeren. Token skal have Workers Scripts: Edit og
# Workers KV Storage: Edit.
CF_ACCOUNT_ID=
CF_API_TOKEN=
