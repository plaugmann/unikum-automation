# Filer der skal koere paa Linux, skal have LF - ogsaa naar de er redigeret
# paa Windows. Et shellscript med CRLF fejler med "bad interpreter: ^M".
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
deploy/**       text eol=lf

# Python og JS koerer begge steder; hold dem ensartede i repoet.
*.py            text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
